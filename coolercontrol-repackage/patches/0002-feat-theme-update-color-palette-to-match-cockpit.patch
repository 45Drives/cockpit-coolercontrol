 coolercontrol-ui/tailwind.config.js | 26 +++++++++++++-------------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/coolercontrol-ui/tailwind.config.js b/coolercontrol-ui/tailwind.config.js
index f9190866..31928f80 100644
--- a/coolercontrol-ui/tailwind.config.js
+++ b/coolercontrol-ui/tailwind.config.js
@@ -152,16 +152,16 @@ module.exports = {
                     // mediaQuery: '@media (prefers-color-scheme: light)',
                     extend: {
                         colors: {
-                            accent: '#4d8cff',
+                            accent: '#92c5f9',
                             // The brand magenta washes out on a light ground, so it
                             // deepens within its own hue, as success/warning do below.
-                            'accent-gradient-to': '#cc00cc',
-                            'bg-one': '#f5f6f9',
-                            'bg-two': '#dfe0e0',
-                            'border-one': '#3c454d',
