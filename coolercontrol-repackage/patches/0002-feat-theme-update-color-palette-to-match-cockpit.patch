-                            'text-color-secondary': '#6c757d',
+                            'text-color': 'rgb(21, 21, 21)',
+                            'text-color-secondary': 'rgb(112, 112, 112)',
                             white: '#f5f6f9',
                             pink: '#ff007f',
                             green: '#00ff7f',
@@ -187,15 +187,15 @@ module.exports = {
                     // mediaQuery: '@media (prefers-color-scheme: dark)',
                     extend: {
                         colors: {
-                            accent: '#4d8cff',
-                            'accent-gradient-to': '#ff21ff',
-                            'bg-one': '#1b1e23',
-                            'bg-two': '#2c313c',
+                            accent: '#92c5f9',
+                            'accent-gradient-to': '#92c5f9',
+                            'bg-one': '#292929',
+                            'bg-two': '#151515',
                             // 'border-one': '#343b48',
                             'border-one': '#484d5a',
                             'surface-hover': 'rgba(255, 255, 255, 0.05)',
-                            'text-color': '#dce1ec',
-                            'text-color-secondary': '#8a95aa',
+                            'text-color': '#ffffff',
+                            'text-color-secondary': 'rgb(199, 199, 199)',
                             white: '#f5f6f9',
                             pink: '#ff007f',
                             green: '#00ff7f',
