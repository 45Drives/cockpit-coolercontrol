From 9ff88c66241ddddec096ad6d35dd1a6531b6ddbe Mon Sep 17 00:00:00 2001
From: joshuaboud <joshuaboud@hotmail.com>
Date: Fri, 11 Sep 2026 17:13:20 -0300
Subject: [PATCH 4/4] Cargo.toml: opt in to edition2024 feature for focal build

---
 coolercontrold/Cargo.toml           | 1 +
 coolercontrold/cc-detect/Cargo.toml | 1 +
 coolercontrold/cc-image/Cargo.toml  | 1 +
 coolercontrold/cc-stress/Cargo.toml | 1 +
 coolercontrold/daemon/Cargo.toml    | 1 +
 5 files changed, 5 insertions(+)

diff --git a/coolercontrold/Cargo.toml b/coolercontrold/Cargo.toml
index c616f720..998376ad 100644
--- a/coolercontrold/Cargo.toml
+++ b/coolercontrold/Cargo.toml
@@ -1,3 +1,4 @@
+cargo-features = ["edition2024"]
 [workspace]
 members = ["daemon", "cc-detect", "cc-image", "cc-stress"]
 resolver = "3"
diff --git a/coolercontrold/cc-detect/Cargo.toml b/coolercontrold/cc-detect/Cargo.toml
index 030688f4..cde9618d 100644
--- a/coolercontrold/cc-detect/Cargo.toml
+++ b/coolercontrold/cc-detect/Cargo.toml
@@ -1,3 +1,4 @@
+cargo-features = ["edition2024"]
 [package]
 name = "cc-detect"
 version = "1.0.0"
diff --git a/coolercontrold/cc-image/Cargo.toml b/coolercontrold/cc-image/Cargo.toml
index 18bbc1b4..820f4ad5 100644
--- a/coolercontrold/cc-image/Cargo.toml
+++ b/coolercontrold/cc-image/Cargo.toml
@@ -1,3 +1,4 @@
+cargo-features = ["edition2024"]
 [package]
 name = "cc-image"
 version = "1.0.0"
diff --git a/coolercontrold/cc-stress/Cargo.toml b/coolercontrold/cc-stress/Cargo.toml
index ca7ff3c7..165bf470 100644
--- a/coolercontrold/cc-stress/Cargo.toml
+++ b/coolercontrold/cc-stress/Cargo.toml
@@ -1,3 +1,4 @@
+cargo-features = ["edition2024"]
 [package]
 name = "cc-stress"
 version = "0.2.0"
diff --git a/coolercontrold/daemon/Cargo.toml b/coolercontrold/daemon/Cargo.toml
index 63b753be..a3266cae 100644
--- a/coolercontrold/daemon/Cargo.toml
+++ b/coolercontrold/daemon/Cargo.toml
@@ -1,3 +1,4 @@
+cargo-features = ["edition2024"]
 [package]
 name = "coolercontrold"
 version = "5.0.0"
-- 
2.52.0

