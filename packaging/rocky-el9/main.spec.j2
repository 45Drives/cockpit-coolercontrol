Name: {{ name }}
Version: {{ version }}
Release: {{ build_number }}%{?dist}
Summary: {{ description }}
License: {{ license }}
URL: {{ git_url }}
Source0: %{name}-%{version}.tar.gz
BuildArch: {{ architecture.rocky }}
Requires: {{ dependencies.rocky_common | join(',') }}


BuildRoot: %{_tmppath}/%{name}-%{version}-%{release}-root

%description
{{ title }}
{{ description }}

%package -n 45d-fancontrol
Summary: Meta package for fan control on 45Drives servers
Requires: %{name} = %{version}-%{release}
Recommends: ipmi-hwmon
Recommends: drivetemp
Recommends: ipmb-bus
%description -n 45d-fancontrol
Meta package for fan control on 45Drives servers: pulls in %{name}, ipmi-hwmon, and drivetemp.

%prep
%setup -q

%build
make OS_PACKAGE_RELEASE=el9

%install
make DESTDIR=%{buildroot} OS_PACKAGE_RELEASE=el9 install

%files
/usr/share/cockpit/coolercontrol/*
/etc/systemd/system/coolercontrold.service.d/cockpit-coolercontrol.conf

%changelog
